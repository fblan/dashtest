    {
      "type": "stat",
      "title": "Steps with regressions / fixes (click to list them)",
      "description": "Steps with at least one action regressed / fixed. Compared with the run selected in \"Compare with\", action by action (matched by step and action position); skipped and failed count as not passing. Regression: an action passed before and does not pass now. Fix: the reverse.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.steps_regressed AS regressions, d.steps_fixed AS fixes FROM test_diff($test, coalesce(nullif($compare, 0), (SELECT prev_test_id FROM v_test_result WHERE test_id = $test))) d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "nothing to compare with"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "regressions"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only the steps with regressions",
                    "url": "/d/kitchen-test/test-details?var-test=${test}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-step_status=%24__all&var-change=regression"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fixes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only the steps with fixes",
                    "url": "/d/kitchen-test/test-details?var-test=${test}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-step_status=%24__all&var-change=fix"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "id": 6,
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Steps: ${step_status:text}, ${change:text} (click a step to open it)",
      "description": "actions with regressions / fixes: actions of the step that passed in the compared run and do not pass now / did not pass and pass now. Empty = no compared run.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.id AS step_id,\n       CASE WHEN $compare = 0 THEN 0\n            ELSE coalesce((SELECT id FROM step WHERE test_id = b.id AND position = s.position), 0) END AS compare_step,\n       s.position AS \"#\", s.description, s.expected_result AS expected, s.actual_result AS actual,\n       s.status::text AS status, d.actions,\n       CASE WHEN b.id IS NOT NULL THEN d.actions_regressed END AS \"actions with regressions\",\n       CASE WHEN b.id IS NOT NULL THEN d.actions_fixed END AS \"actions with fixes\"\nFROM (SELECT coalesce(nullif($compare, 0), (SELECT prev_test_id FROM v_test_result WHERE test_id = $test)) AS id) b\nCROSS JOIN step_diff($test, b.id) d\nJOIN step s ON s.id = d.step_id\nWHERE s.status::text IN ($step_status)\n  AND CASE '$change' WHEN 'regression' THEN d.actions_regressed > 0\n                     WHEN 'fix'        THEN d.actions_fixed > 0\n                     ELSE true END\nORDER BY s.position"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "text": "success",
                        "index": 0
                      },
                      "skipped": {
                        "color": "orange",
                        "text": "skipped",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "text": "failed",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "#"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(description|expected|actual)$"
            },
            "properties": [
              {
                "id": "custom.wrapText",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(step_id|compare_step)$"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(#|description)$"
            },
            "properties": [
              {
                "id": "links",
