    "list": [
      {
        "type": "query",
        "name": "platform",
        "label": "Platform",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "query": "SELECT code || ' — ' || name AS __text, code AS __value FROM platform ORDER BY code",
        "definition": "SELECT code || ' — ' || name AS __text, code AS __value FROM platform ORDER BY code",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "query",
        "name": "test",
        "label": "Test run",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "query": "SELECT t.name || '  —  ' || c.label || '  (' || t.status || ')' AS __text, t.id AS __value FROM test t JOIN v_campaign c ON c.id = t.campaign_id WHERE c.platform IN ($platform) ORDER BY c.started_at DESC, t.rank",
        "definition": "SELECT t.name || '  —  ' || c.label || '  (' || t.status || ')' AS __text, t.id AS __value FROM test t JOIN v_campaign c ON c.id = t.campaign_id WHERE c.platform IN ($platform) ORDER BY c.started_at DESC, t.rank",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "current": {},
        "options": []
      },
      {
        "type": "query",
        "name": "compare",
        "label": "Compare with",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "query": "SELECT __text, __value FROM (\n    SELECT 0 AS ord, NULL::timestamptz AS started_at, 0 AS __value,\n           'previous run on this platform: ' || coalesce(pc.label || '  (' || p.status || ')', 'none') AS __text\n    FROM v_test_result r LEFT JOIN v_test_result p ON p.test_id = r.prev_test_id\n    LEFT JOIN v_campaign pc ON pc.id = p.campaign_id WHERE r.test_id = $test\n    UNION ALL\n    SELECT 1, o.campaign_started_at, o.test_id, oc.label || '  (' || o.status || ')'\n    FROM v_test_result r JOIN v_test_result o ON o.name = r.name AND o.platform = r.platform AND o.test_id <> r.test_id\n    JOIN v_campaign oc ON oc.id = o.campaign_id WHERE r.test_id = $test\n) x ORDER BY ord, started_at DESC",
        "definition": "SELECT __text, __value FROM (\n    SELECT 0 AS ord, NULL::timestamptz AS started_at, 0 AS __value,\n           'previous run on this platform: ' || coalesce(pc.label || '  (' || p.status || ')', 'none') AS __text\n    FROM v_test_result r LEFT JOIN v_test_result p ON p.test_id = r.prev_test_id\n    LEFT JOIN v_campaign pc ON pc.id = p.campaign_id WHERE r.test_id = $test\n    UNION ALL\n    SELECT 1, o.campaign_started_at, o.test_id, oc.label || '  (' || o.status || ')'\n    FROM v_test_result r JOIN v_test_result o ON o.name = r.name AND o.platform = r.platform AND o.test_id <> r.test_id\n    JOIN v_campaign oc ON oc.id = o.campaign_id WHERE r.test_id = $test\n) x ORDER BY ord, started_at DESC",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "current": {},
        "options": []
      },
      {
        "type": "custom",
        "name": "step_status",
        "label": "Status",
        "hide": 2,
        "query": "success,skipped,failed",
        "multi": true,
        "includeAll": true,
