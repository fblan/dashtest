    {
      "type": "table",
      "title": "History of this test on the same platform (click a date to open that run)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.test_id AS id, to_char(r.campaign_started_at, 'YYYY-MM-DD HH24:MI') AS date,\n       r.kms_version AS \"KMS\", r.status::text AS status, r.transition,\n       r.changes AS \"changed since previous run\", r.duration_s / 60.0 AS duration,\n       f.step_position || '.' || f.action_position AS \"stopped at\", split_part(f.action_description, E'\\n', 1) AS action,\n       f.expected_result AS expected, f.actual_result AS actual\nFROM v_test_result r LEFT JOIN v_first_failure f ON f.test_id = r.test_id\nWHERE (r.name, r.platform) = (SELECT t.name, c.platform FROM test t JOIN campaign c ON c.id = t.campaign_id\n                              WHERE t.id = $test)\nORDER BY r.campaign_started_at DESC"
        }
      ],
