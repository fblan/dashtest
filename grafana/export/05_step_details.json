          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN changes = 'no change'\n            THEN 'None — last change ' || to_char(last_change_at, 'YYYY-MM-DD') || ': ' || last_change\n            ELSE changes END AS changes\nFROM v_campaign WHERE id = (SELECT t.campaign_id FROM step s JOIN test t ON t.id = s.test_id WHERE s.id = $step)"
        }
      ],
      "fieldConfig": {
        "defaults": {
