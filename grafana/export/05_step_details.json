              {
                "id": "links",
                "value": [
                  {
                    "title": "Show failed actions",
                    "url": "/d/kitchen-step/step-details?var-test=${test}&var-step=${step}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-action_status=failed&var-change=all"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Actions with regressions / fixes (click to list them)",
      "description": "Actions of the step regressed / fixed. Compared with the run selected in \"Compare with\", action by action (matched by step and action position); skipped and failed count as not passing. Regression: an action passed before and does not pass now. Fix: the reverse.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.actions_regressed AS regressions, d.actions_fixed AS fixes\nFROM (SELECT coalesce(nullif($compare, 0), (SELECT ps.id FROM step s JOIN v_test_result r ON r.test_id = s.test_id\n    JOIN step ps ON ps.test_id = r.prev_test_id AND ps.position = s.position WHERE s.id = $step)) AS id) b\nJOIN step bs ON bs.id = b.id\nCROSS JOIN step_diff((SELECT test_id FROM step WHERE id = $step), bs.test_id) d\nWHERE d.step_id = $step"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "nothing to compare with"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "regressions"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only the actions with regressions",
                    "url": "/d/kitchen-step/step-details?var-test=${test}&var-step=${step}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-action_status=%24__all&var-change=regression"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fixes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only the actions with fixes",
                    "url": "/d/kitchen-step/step-details?var-test=${test}&var-step=${step}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-action_status=%24__all&var-change=fix"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "id": 5,
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Step",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT description, expected_result AS expected, actual_result AS actual FROM step WHERE id = $step"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(description|expected|actual)$"
            },
            "properties": [
              {
                "id": "custom.wrapText",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 5
      }
    },
    {
      "type": "table",
      "title": "Actions: ${action_status:text}, ${change:text}",
      "description": "evolution, then current run: status, expected, actual, then compared run (same action): status, expected, actual. evolution: regression = passed in the compared run and does not pass now (skipped / failed), fixed = the reverse.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT a.position AS \"#\", a.description, status_change(a.status, pa.status) AS evolution,\n       a.status::text AS status, a.expected_result AS expected, a.actual_result AS actual,\n       pa.status::text AS \"compared status\", pa.expected_result AS \"compared expected\", pa.actual_result AS \"compared actual\"\nFROM action a\nLEFT JOIN action pa ON pa.step_id = coalesce(nullif($compare, 0), (SELECT ps.id FROM step s JOIN v_test_result r ON r.test_id = s.test_id\n    JOIN step ps ON ps.test_id = r.prev_test_id AND ps.position = s.position WHERE s.id = $step)) AND pa.position = a.position\nWHERE a.step_id = $step AND a.status::text IN ($action_status)\n  AND CASE '$change' WHEN 'regression' THEN status_change(a.status, pa.status) = 'regression'\n                     WHEN 'fix'        THEN status_change(a.status, pa.status) = 'fixed'\n                     ELSE true END\nORDER BY a.position"
        }
      ],
