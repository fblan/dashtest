    {
      "type": "stat",
      "title": "Actions with regressions / fixes",
      "description": "Compared action by action with the same step in the compared run (matched by action position); skipped and failed count as not passing. Regression: the action passed before and does not pass now. Fix: it did not pass before and passes now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.actions_regressed AS regressions, d.actions_fixed AS fixes\nFROM (SELECT coalesce(nullif($compare, 0), (SELECT ps.id FROM step s JOIN v_test_result r ON r.test_id = s.test_id\n    JOIN step ps ON ps.test_id = r.prev_test_id AND ps.position = s.position WHERE s.id = $step)) AS id) b\nJOIN step bs ON bs.id = b.id\nCROSS JOIN step_diff((SELECT test_id FROM step WHERE id = $step), bs.test_id) d\nWHERE d.step_id = $step"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no compared run"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "regressions"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fixes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "id": 12,
      "gridPos": {
        "x": 14,
        "y": 15,
        "w": 10,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Actions",
      "description": "evolution, then current run: status, expected, actual, then compared run (same action): status, expected, actual. evolution: regression = passed in the compared run and does not pass now (skipped / failed), fixed = the reverse.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT a.position AS \"#\", a.description, status_change(a.status, pa.status) AS evolution,\n       a.status::text AS status, a.expected_result AS expected, a.actual_result AS actual,\n       pa.status::text AS \"compared status\", pa.expected_result AS \"compared expected\", pa.actual_result AS \"compared actual\"\nFROM action a\nLEFT JOIN action pa ON pa.step_id = coalesce(nullif($compare, 0), (SELECT ps.id FROM step s JOIN v_test_result r ON r.test_id = s.test_id\n    JOIN step ps ON ps.test_id = r.prev_test_id AND ps.position = s.position WHERE s.id = $step)) AND pa.position = a.position\nWHERE a.step_id = $step ORDER BY a.position"
        }
      ],
