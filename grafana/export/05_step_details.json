    {
      "type": "stat",
      "title": "Software versions",
      "description": "KMS = Kitchen Management System (system under test), KES = KitEquipmentSimulator, KTRS = Kitchen Test Runner System, Gateway, TestCampaign = test definitions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT kms_version AS \"KMS (under test)\", kes_version AS \"KES\", ktrs_version AS \"KTRS\",\n       gateway_version AS \"Gateway\", testcampaign_version AS \"TestCampaign\"\nFROM campaign WHERE id = (SELECT t.campaign_id FROM step s JOIN test t ON t.id = s.test_id WHERE s.id = $step)"
