    {
      "type": "table",
      "title": "History of this step on the same platform (click a date to open that run)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.test_id, s.id AS step_id, to_char(r.campaign_started_at, 'YYYY-MM-DD HH24:MI') AS date,\n       r.kms_version AS \"KMS\", s.status::text AS status, s.actual_result AS actual\nFROM step cur\nJOIN test ct ON ct.id = cur.test_id\nJOIN v_test_result cr ON cr.test_id = ct.id\nJOIN v_test_result r ON r.name = cr.name AND r.platform = cr.platform\nJOIN step s ON s.test_id = r.test_id AND s.position = cur.position\nWHERE cur.id = $step\nORDER BY r.campaign_started_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
