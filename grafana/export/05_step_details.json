                "value": [
                  {
                    "title": "Show all actions",
                    "url": "/d/kitchen-step/step-details?var-test=${test}&var-step=${step}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-action_status=%24__all&var-change=all"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show success actions",
                    "url": "/d/kitchen-step/step-details?var-test=${test}&var-step=${step}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-action_status=success&var-change=all"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
