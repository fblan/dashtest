            "value": "skipped",
            "selected": false
          },
          {
            "text": "failed",
            "value": "failed",
            "selected": false
          }
        ]
      },
      {
        "type": "custom",
        "name": "change",
        "label": "Change vs compared run",
        "hide": 2,
        "query": "all actions : all, with regressions : regression, with fixes : fix",
        "current": {
          "text": "all actions",
          "value": "all"
        },
        "options": [
          {
            "text": "all actions",
            "value": "all",
            "selected": true
          },
          {
            "text": "with regressions",
            "value": "regression",
            "selected": false
          },
          {
            "text": "with fixes",
            "value": "fix",
            "selected": false
          }
        ]
      }
    ]
  },
