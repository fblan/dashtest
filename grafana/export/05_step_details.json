    {
      "type": "stat",
      "title": "Duration",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(duration_ms) / 1000.0 AS duration FROM action WHERE step_id = $step"
        }
      ],
      "fieldConfig": {
