                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show skipped actions",
                    "url": "/d/kitchen-step/step-details?var-test=${test}&var-step=${step}&var-compare=${compare}&${platform:queryparam}&${__url_time_range}&var-action_status=skipped&var-change=all"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
