    {
      "type": "stat",
      "title": "Compared with (click to open it)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(c.label || '  (step ' || ps.status || ')', 'none: first run of this test on this platform')\n           AS compared, ps.test_id AS base_test, ps.id AS base_step\nFROM (SELECT coalesce(nullif($compare, 0), (SELECT ps.id FROM step s JOIN v_test_result r ON r.test_id = s.test_id\n    JOIN step ps ON ps.test_id = r.prev_test_id AND ps.position = s.position WHERE s.id = $step)) AS id) b\nLEFT JOIN step ps ON ps.id = b.id LEFT JOIN test pt ON pt.id = ps.test_id\nLEFT JOIN v_campaign c ON c.id = pt.campaign_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open the compared step",
              "url": "/d/kitchen-step/step-details?var-test=${__data.fields.base_test}&var-step=${__data.fields.base_step}&var-compare=0&${platform:queryparam}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^compared$/"
