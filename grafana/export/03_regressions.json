      {
        "name": "KMS releases",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT min(started_at) AS time, 'KMS ' || kms_version AS text, 'KMS' AS tags FROM campaign WHERE platform IN ($platform) GROUP BY kms_version"
        }
      },
      {
        "name": "Other component releases (KES, KTRS, Gateway, TestCampaign)",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "target": {
          "refId": "Anno2",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT min(started_at) AS time, 'KES ' || kes_version AS text, 'KES' AS tags FROM campaign WHERE platform IN ($platform) GROUP BY kes_version HAVING min(started_at) > (SELECT min(started_at) FROM campaign)\nUNION ALL\nSELECT min(started_at) AS time, 'KTRS ' || ktrs_version AS text, 'KTRS' AS tags FROM campaign WHERE platform IN ($platform) GROUP BY ktrs_version HAVING min(started_at) > (SELECT min(started_at) FROM campaign)\nUNION ALL\nSELECT min(started_at) AS time, 'Gateway ' || gateway_version AS text, 'Gateway' AS tags FROM campaign WHERE platform IN ($platform) GROUP BY gateway_version HAVING min(started_at) > (SELECT min(started_at) FROM campaign)\nUNION ALL\nSELECT min(started_at) AS time, 'TestCampaign ' || testcampaign_version AS text, 'TestCampaign' AS tags FROM campaign WHERE platform IN ($platform) GROUP BY testcampaign_version HAVING min(started_at) > (SELECT min(started_at) FROM campaign)"
        }
      }
    ]
