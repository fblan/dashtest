                        "color": "purple",
                        "index": 0
                      },
                      "OUT": {
                        "color": "#2f9e8f",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open test details",
                    "url": "/d/kitchen-test/test-details?var-test=${__data.fields.id}&var-compare=0&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(changed since previous run|action|expected|actual)$"
            },
            "properties": [
              {
                "id": "custom.wrapText",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 14
      }
    },
