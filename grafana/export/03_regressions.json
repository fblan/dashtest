  "panels": [
    {
      "type": "barchart",
      "title": "Regressions & fixes per KMS version (vs previous campaign on the same platform)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT kms_version AS \"KMS\",\n       count(*) FILTER (WHERE transition = 'regression') AS regressions,\n       count(*) FILTER (WHERE transition = 'fixed') AS fixes\nFROM v_test_result WHERE $__timeFilter(campaign_started_at) AND platform IN ($platform)\nGROUP BY kms_version, kms_version_order ORDER BY kms_version_order"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "regressions"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fixes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "KMS",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.8,
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 9
      }
    },
    {
      "type": "bargauge",
      "title": "Flakiest tests (status flips, last 15 campaigns per platform)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT platform || ' · ' || name AS test, flips FROM v_flakiness WHERE flips > 0 AND platform IN ($platform) ORDER BY flips DESC, 1 LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^flips$/"
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 9
      }
    },
    {
      "type": "status-history",
      "title": "Test status history on $platform: green = success, orange = skipped, red = failed (one column per campaign)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT campaign_started_at AS time, name AS metric,\n       CASE status WHEN 'success' THEN 0 WHEN 'skipped' THEN 1 ELSE 2 END AS value\nFROM v_test_result WHERE $__timeFilter(campaign_started_at) AND platform IN (${platform:sqlstring})\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "green",
                  "text": "success",
                  "index": 0
                },
                "1": {
                  "color": "orange",
                  "text": "skipped",
                  "index": 1
                },
                "2": {
                  "color": "red",
                  "text": "failed",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "colWidth": 0.95,
        "legend": {
          "showLegend": false
        }
      },
      "repeat": "platform",
      "repeatDirection": "v",
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "KMS version comparison: $base → $target (failure rate per test and platform)",
      "description": "Compares the share of failed runs of each test between two KMS versions, per platform. A delta >= 50 points is flagged as a regression.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH r AS (\n    SELECT name, platform, kms_version,\n           100.0 * count(*) FILTER (WHERE status = 'failed') / count(*) AS fail_rate,\n           count(*) AS runs\n    FROM v_test_result WHERE kms_version IN ('$base', '$target') AND platform IN ($platform)\n    GROUP BY name, platform, kms_version\n)\nSELECT b.platform, b.name,\n       round(b.fail_rate) AS \"base fail %\", b.runs AS \"base runs\",\n       round(t.fail_rate) AS \"target fail %\", t.runs AS \"target runs\",\n       round(t.fail_rate - b.fail_rate) AS \"delta %\",\n       CASE WHEN t.fail_rate - b.fail_rate >= 50 THEN 'regression'\n            WHEN b.fail_rate - t.fail_rate >= 50 THEN 'fixed'\n            WHEN t.fail_rate > 0 THEN 'still_failing'\n            ELSE 'stable_ok' END AS verdict\nFROM r b JOIN r t ON t.name = b.name AND t.platform = b.platform\nWHERE b.kms_version = '$base' AND t.kms_version = '$target'\nORDER BY \"delta %\" DESC, b.name, b.platform"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "regression": {
                        "color": "red",
                        "text": "▼ regression",
                        "index": 0
                      },
                      "fixed": {
                        "color": "green",
                        "text": "▲ fixed",
                        "index": 1
                      },
                      "still_failing": {
                        "color": "dark-red",
                        "text": "still failing",
                        "index": 2
                      },
                      "stable_ok": {
                        "color": "transparent",
                        "text": "ok",
                        "index": 3
                      },
                      "new": {
                        "color": "blue",
                        "text": "new",
                        "index": 4
                      },
                      "skipped": {
                        "color": "orange",
                        "text": "skipped",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "platform"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "IN": {
                        "color": "purple",
                        "index": 0
                      },
                      "OUT": {
                        "color": "#2f9e8f",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "delta %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Regressions (success → failed) with what changed and root cause",
      "description": "'changed since previous run' lists the software versions that differ from the previous campaign on the same platform: the suspects for the regression.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.test_id AS id, r.campaign_started_at AS date, r.platform, r.name,\n       r.changes AS \"changed since previous run\",\n       f.step_position || '.' || f.action_position AS \"at\",\n       split_part(f.action_description, E'\\n', 1) AS action,\n       f.expected_result AS expected, f.actual_result AS actual\nFROM v_test_result r LEFT JOIN v_first_failure f ON f.test_id = r.test_id\nWHERE r.transition = 'regression' AND $__timeFilter(r.campaign_started_at) AND r.platform IN ($platform)\nORDER BY 2 DESC, r.rank"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "date"
