  "panels": [
    {
      "type": "stat",
      "title": "Platform and versions",
      "description": "KMS = Kitchen Management System (system under test), KES = KitEquipmentSimulator, KTRS = Kitchen Test Runner System, Gateway, TestCampaign = test definitions. Orange ▲: version changed since the previous campaign on the platform.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT c.platform AS \"Platform\",\n       c.kms_version || CASE WHEN c.kms_version <> prev.kms_version THEN ' ▲' ELSE '' END AS \"KMS (under test)\",\n       c.kes_version || CASE WHEN c.kes_version <> prev.kes_version THEN ' ▲' ELSE '' END AS \"KES\",\n       c.ktrs_version || CASE WHEN c.ktrs_version <> prev.ktrs_version THEN ' ▲' ELSE '' END AS \"KTRS\",\n       c.gateway_version || CASE WHEN c.gateway_version <> prev.gateway_version THEN ' ▲' ELSE '' END AS \"Gateway\",\n       c.testcampaign_version || CASE WHEN c.testcampaign_version <> prev.testcampaign_version THEN ' ▲' ELSE '' END AS \"TestCampaign\"\nFROM v_campaign c LEFT JOIN v_campaign prev ON prev.id = c.prev_campaign_id\nWHERE c.id = $campaign"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "transparent"
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": ".* ▲$",
                "result": {
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "KMS (under test)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^(?!.*_id$).*/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true,
        "text": {
          "titleSize": 12,
          "valueSize": 20
        }
