    {
      "type": "stat",
      "title": "Tests with regressions / fixes (click to list them)",
      "description": "Tests with at least one action regressed / fixed; tests matched by name. Compared with the run selected in \"Compare with\", action by action (matched by step and action position); skipped and failed count as not passing. Regression: an action passed before and does not pass now. Fix: the reverse.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE d.actions_regressed > 0) AS regressions,\n       count(*) FILTER (WHERE d.actions_fixed > 0) AS fixes\nFROM test t LEFT JOIN test bt ON bt.campaign_id = coalesce(nullif($compare, 0), (SELECT prev_campaign_id FROM v_campaign WHERE id = $campaign)) AND bt.name = t.name\nLEFT JOIN LATERAL test_diff(t.id, bt.id) d ON true\nWHERE t.campaign_id = $campaign\nHAVING coalesce(nullif($compare, 0), (SELECT prev_campaign_id FROM v_campaign WHERE id = $campaign)) IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "nothing to compare with"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "regressions"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only the tests with regressions",
                    "url": "/d/kitchen-overview/campaign-overview?var-campaign=${campaign}&${compare:queryparam}&${platform:queryparam}&${__url_time_range}&var-test_status=%24__all&var-change=regression"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fixes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only the tests with fixes",
                    "url": "/d/kitchen-overview/campaign-overview?var-campaign=${campaign}&${compare:queryparam}&${platform:queryparam}&${__url_time_range}&var-test_status=%24__all&var-change=fix"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "id": 6,
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Tests: ${test_status:text}, ${change:text} (click a name to drill down)",
      "description": "steps with regressions / fixes: steps containing at least one action that passed in the compared campaign and does not pass now / did not pass and passes now. Empty = no compared campaign, or the test is not in it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.id, CASE WHEN $compare = 0 THEN 0 ELSE coalesce(bt.id, 0) END AS compare_test,\n       t.name, t.status::text AS status,\n       (SELECT count(*) FROM step WHERE test_id = t.id) AS steps,\n       d.steps_regressed AS \"steps with regressions\", d.steps_fixed AS \"steps with fixes\",\n       extract(epoch FROM t.ended_at - t.started_at) / 60 AS duration\nFROM test t LEFT JOIN test bt ON bt.campaign_id = coalesce(nullif($compare, 0), (SELECT prev_campaign_id FROM v_campaign WHERE id = $campaign)) AND bt.name = t.name\nLEFT JOIN LATERAL test_diff(t.id, bt.id) d ON true\nWHERE t.campaign_id = $campaign AND t.status::text IN ($test_status)\n  AND CASE '$change' WHEN 'regression' THEN d.actions_regressed > 0\n                     WHEN 'fix'        THEN d.actions_fixed > 0\n                     ELSE true END\nORDER BY t.rank"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "text": "success",
                        "index": 0
                      },
                      "skipped": {
                        "color": "orange",
                        "text": "skipped",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "text": "failed",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(id|compare_test)$"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open test details",
                    "url": "/d/kitchen-test/test-details?var-test=${__data.fields.id}&var-compare=${__data.fields.compare_test}&${__url_time_range}&var-step_status=%24__all&var-change=all"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "steps"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
