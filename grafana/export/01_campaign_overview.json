  "uid": "kitchen-overview",
  "title": "Campaign overview",
  "tags": [
    "kitchen",
    "qa"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-7M",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "platform",
        "label": "Platform",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "query": "SELECT code || ' — ' || name AS __text, code AS __value FROM platform ORDER BY code",
        "definition": "SELECT code || ' — ' || name AS __text, code AS __value FROM platform ORDER BY code",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "query",
        "name": "campaign",
        "label": "Campaign",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "query": "SELECT label || '  (' || status || ')' AS __text, id AS __value FROM v_campaign WHERE platform IN ($platform) ORDER BY started_at DESC",
        "definition": "SELECT label || '  (' || status || ')' AS __text, id AS __value FROM v_campaign WHERE platform IN ($platform) ORDER BY started_at DESC",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "current": {},
        "options": []
      },
      {
        "type": "custom",
        "name": "test_status",
        "label": "Test status",
        "hide": 2,
        "query": "success,skipped,failed",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "success",
            "value": "success",
            "selected": false
          },
          {
            "text": "skipped",
            "value": "skipped",
            "selected": false
          },
          {
            "text": "failed",
            "value": "failed",
            "selected": false
          }
        ]
      },
      {
        "type": "custom",
        "name": "change",
        "label": "Change vs previous run",
        "hide": 2,
        "query": "all tests : all, with regressions : regression, with fixes : fix",
        "current": {
          "text": "all tests",
          "value": "all"
        },
        "options": [
          {
            "text": "all tests",
            "value": "all",
            "selected": true
          },
          {
            "text": "with regressions",
            "value": "regression",
            "selected": false
          },
          {
            "text": "with fixes",
            "value": "fix",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
