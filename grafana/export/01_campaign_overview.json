        "query": "SELECT DISTINCT platform FROM campaign ORDER BY 1",
        "definition": "SELECT DISTINCT platform FROM campaign ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "current": {
          "text": [
