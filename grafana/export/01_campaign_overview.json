    {
      "type": "table",
      "title": "Tests: ${test_status:text} (click a name to drill down)",
      "description": "transition = compared with the previous campaign on the same platform",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.id, t.name, t.status::text AS status, r.transition,\n       s.ok AS \"steps ok\", s.skip AS \"steps skip\", s.fail AS \"steps fail\",\n       a.ok AS \"actions ok\", a.skip AS \"actions skip\", a.fail AS \"actions fail\",\n       r.duration_s / 60.0 AS duration\nFROM test t\nJOIN v_test_result r ON r.test_id = t.id\nCROSS JOIN LATERAL (\n    SELECT count(*) FILTER (WHERE status = 'success') AS ok,\n           count(*) FILTER (WHERE status = 'skipped') AS skip,\n           count(*) FILTER (WHERE status = 'failed')  AS fail\n    FROM step WHERE test_id = t.id) s\nCROSS JOIN LATERAL (\n    SELECT count(*) FILTER (WHERE a.status = 'success') AS ok,\n           count(*) FILTER (WHERE a.status = 'skipped') AS skip,\n           count(*) FILTER (WHERE a.status = 'failed')  AS fail\n    FROM action a JOIN step st ON st.id = a.step_id WHERE st.test_id = t.id) a\nWHERE t.campaign_id = $campaign AND t.status::text IN ($test_status)\nORDER BY t.rank"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "text": "success",
                        "index": 0
                      },
                      "skipped": {
                        "color": "orange",
                        "text": "skipped",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "text": "failed",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "transition"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "regression": {
                        "color": "red",
                        "text": "▼ regression",
                        "index": 0
                      },
                      "fixed": {
                        "color": "green",
                        "text": "▲ fixed",
                        "index": 1
                      },
                      "still_failing": {
                        "color": "dark-red",
                        "text": "still failing",
                        "index": 2
                      },
                      "stable_ok": {
                        "color": "transparent",
                        "text": "ok",
                        "index": 3
                      },
                      "new": {
                        "color": "blue",
                        "text": "new",
                        "index": 4
                      },
                      "skipped": {
                        "color": "orange",
                        "text": "skipped",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
