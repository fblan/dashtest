        "type": "query",
        "name": "campaign",
        "label": "Campaign",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "query": "SELECT label || '  (' || status || ')' AS __text, id AS __value FROM v_campaign WHERE platform IN ($platform) ORDER BY started_at DESC",
        "definition": "SELECT label || '  (' || status || ')' AS __text, id AS __value FROM v_campaign WHERE platform IN ($platform) ORDER BY started_at DESC",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "current": {},
        "options": []
      },
      {
        "type": "query",
        "name": "compare",
        "label": "Compare with",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_KITCHEN}"
        },
        "query": "SELECT __text, __value FROM (\n    SELECT 0 AS ord, NULL::timestamptz AS started_at, 0 AS __value,\n           'previous on this platform: ' || coalesce(p.label || '  (' || p.status || ')', 'none') AS __text\n    FROM v_campaign c LEFT JOIN v_campaign p ON p.id = c.prev_campaign_id WHERE c.id = $campaign\n    UNION ALL\n    SELECT 1, o.started_at, o.id, o.label || '  (' || o.status || ')'\n    FROM v_campaign c JOIN v_campaign o ON o.platform = c.platform AND o.id <> c.id WHERE c.id = $campaign\n) x ORDER BY ord, started_at DESC",
        "definition": "SELECT __text, __value FROM (\n    SELECT 0 AS ord, NULL::timestamptz AS started_at, 0 AS __value,\n           'previous on this platform: ' || coalesce(p.label || '  (' || p.status || ')', 'none') AS __text\n    FROM v_campaign c LEFT JOIN v_campaign p ON p.id = c.prev_campaign_id WHERE c.id = $campaign\n    UNION ALL\n    SELECT 1, o.started_at, o.id, o.label || '  (' || o.status || ')'\n    FROM v_campaign c JOIN v_campaign o ON o.platform = c.platform AND o.id <> c.id WHERE c.id = $campaign\n) x ORDER BY ord, started_at DESC",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "current": {},
        "options": []
      },
