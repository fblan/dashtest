    {
      "type": "table",
      "title": "Tests: ${test_status:text}, ${change:text} (click a name to drill down)",
      "description": "steps with regressions / fixes: steps containing at least one action that passed in the previous run of the test on this platform and does not pass now / did not pass and passes now. Empty = first run of the test on this platform.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_KITCHEN}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_KITCHEN}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.id, t.name, t.status::text AS status,\n       (SELECT count(*) FROM step WHERE test_id = t.id) AS steps,\n       d.steps_regressed AS \"steps with regressions\", d.steps_fixed AS \"steps with fixes\",\n       extract(epoch FROM t.ended_at - t.started_at) / 60 AS duration\nFROM test t\nLEFT JOIN v_test_diff d ON d.test_id = t.id\nWHERE t.campaign_id = $campaign AND t.status::text IN ($test_status)\n  AND CASE '$change' WHEN 'regression' THEN d.actions_regressed > 0\n                     WHEN 'fix'        THEN d.actions_fixed > 0\n                     ELSE true END\nORDER BY t.rank"
        }
      ],
