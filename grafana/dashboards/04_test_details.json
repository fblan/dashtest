    {
      "type": "stat",
      "title": "Actions with regressions / fixes",
      "description": "Compared action by action with the compared run (matched by step and action position); skipped and failed count as not passing. Regression: the action passed before and does not pass now. Fix: it did not pass before and passes now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kitchen-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kitchen-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.actions_regressed AS regressions, d.actions_fixed AS fixes\nFROM test_diff($test, coalesce(nullif($compare, 0), (SELECT prev_test_id FROM v_test_result WHERE test_id = $test))) d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no compared run"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "regressions"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fixes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "id": 10,
      "gridPos": {
        "x": 14,
        "y": 9,
        "w": 10,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Steps (click a step to open it)",
      "description": "actions with regressions / fixes: actions of the step that passed in the compared run and do not pass now / did not pass and pass now. Empty = no compared run.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kitchen-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kitchen-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.id AS step_id,\n       CASE WHEN $compare = 0 THEN 0\n            ELSE coalesce((SELECT id FROM step WHERE test_id = b.id AND position = s.position), 0) END AS compare_step,\n       s.position AS \"#\", s.description, s.expected_result AS expected, s.actual_result AS actual,\n       s.status::text AS status, d.actions,\n       CASE WHEN b.id IS NOT NULL THEN d.actions_regressed END AS \"actions with regressions\",\n       CASE WHEN b.id IS NOT NULL THEN d.actions_fixed END AS \"actions with fixes\"\nFROM (SELECT coalesce(nullif($compare, 0), (SELECT prev_test_id FROM v_test_result WHERE test_id = $test)) AS id) b\nCROSS JOIN step_diff($test, b.id) d\nJOIN step s ON s.id = d.step_id\nORDER BY s.position"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "text": "success",
                        "index": 0
                      },
                      "skipped": {
                        "color": "orange",
                        "text": "skipped",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "text": "failed",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "#"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(description|expected|actual)$"
            },
            "properties": [
              {
                "id": "custom.wrapText",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(step_id|compare_step)$"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(#|description)$"
            },
            "properties": [
              {
                "id": "links",
                "value": [
