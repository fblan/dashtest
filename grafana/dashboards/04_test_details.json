    {
      "type": "stat",
      "title": "Software versions",
      "description": "KMS = Kitchen Management System (system under test), KES = KitEquipmentSimulator, KTRS = Kitchen Test Runner System, Gateway, TestCampaign = test definitions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kitchen-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kitchen-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT kms_version AS \"KMS (under test)\", kes_version AS \"KES\", ktrs_version AS \"KTRS\",\n       gateway_version AS \"Gateway\", testcampaign_version AS \"TestCampaign\"\nFROM campaign WHERE id = (SELECT campaign_id FROM test WHERE id = $test)"
