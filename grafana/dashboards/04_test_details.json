          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.name, t.status::text AS status, c.platform || ' · ' || p.name AS platform,\n       to_char(c.started_at, 'YYYY-MM-DD HH24:MI') AS campaign, c.id AS campaign_id,\n       extract(epoch FROM t.ended_at - t.started_at) AS duration\nFROM test t JOIN campaign c ON c.id = t.campaign_id JOIN platform p ON p.code = c.platform\nWHERE t.id = $test"
        }
