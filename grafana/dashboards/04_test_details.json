    {
      "type": "stat",
      "title": "Compared with (click to open it)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kitchen-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kitchen-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(c.label || '  (' || r.status || ')', 'none: first run of this test on this platform')\n           AS compared, r.test_id AS base_id\nFROM (SELECT coalesce(nullif($compare, 0), (SELECT prev_test_id FROM v_test_result WHERE test_id = $test)) AS id) b\nLEFT JOIN v_test_result r ON r.test_id = b.id LEFT JOIN v_campaign c ON c.id = r.campaign_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
