          "rawSql": "SELECT CASE WHEN changes = 'no change'\n            THEN 'None — last change ' || to_char(last_change_at, 'YYYY-MM-DD') || ': ' || last_change\n            ELSE changes END AS changes\nFROM v_campaign WHERE id = (SELECT campaign_id FROM test WHERE id = $test)"
