# Local development: copy to .env (cp .env.example .env).
# On Dokploy, set the variables of the second block in the Environment tab instead.

# --- local only: also load docker-compose.local.yml (publishes ports 3000 and 5432)
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COMPOSE_PATH_SEPARATOR=:
PG_PORT=5432
GRAFANA_PORT=3000

# --- needed everywhere (use strong passwords on a server)
PG_USER=kitchen
PG_PASSWORD=kitchen
GRAFANA_RO_PASSWORD=grafana_ro
GRAFANA_ADMIN_PASSWORD=admin
# role of anonymous visitors: Viewer, Editor or Admin
GRAFANA_ANONYMOUS_ROLE=Viewer
# public URL of Grafana (e.g. https://dash.example.com)
GRAFANA_ROOT_URL=http://localhost:3000
